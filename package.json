{
  "name": "liveboom-workspace",
  "private": true,
  "version": "0.2.3",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @liveboom/desktop-app dev",
    "build": "pnpm ui:notices && pnpm plugins:build && pnpm check && pnpm --filter @liveboom/desktop-app build",
    "check": "tsc --noEmit -p tsconfig.json && node tools/check-boundaries.mjs",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "test:rust": "cargo test",
    "gen:types": "cargo test -p play-contracts export_bindings",
    "plugins:build": "pnpm --filter @liveboom/play-registry build && pnpm --filter @liveboom/play-printer-3d build",
    "tauri": "pnpm plugins:build && pnpm --filter @liveboom/desktop-app tauri",
    "test:browser": "node tests/browser.mjs",
    "test:printer": "node tests/printer-browser.mjs",
    "ui:notices": "node tools/ui-notices.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  },
  "license": "MIT"
}
