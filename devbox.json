      "platforms": [
        "x86_64-linux",
        "aarch64-linux"
      ]
    },
    "github:NixOS/nixpkgs/8edc0c72e3a38faf5434e40d1f19431125fe4b30#gtk3.out": {
      "platforms": [
        "x86_64-linux",
        "aarch64-linux"
      ]
    },
    "github:NixOS/nixpkgs/8edc0c72e3a38faf5434e40d1f19431125fe4b30#webkitgtk_4_1.dev": {
      "platforms": [
