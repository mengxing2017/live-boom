      "platforms": [
        "x86_64-linux",
        "aarch64-linux"
      ]
    }
  },
  "shell": {
    "init_hook": [
      "rustup run 1.98.0 rustc --version >/dev/null 2>&1 || rustup toolchain install 1.98.0",
      "rustup default 1.98.0"
    ],
    "scripts": {
      "check": "pnpm check && cargo check",
      "test-unit": "cargo test",
      "fmt": "cargo fmt --all",
      "fmt:check": "cargo fmt --all --check",
      "web": "pnpm dev",
      "desktop": "pnpm tauri dev",
      "desktop:check": "pnpm plugins:build && cargo check -p liveboom",
      "desktop:verify": "pnpm plugins:build && cargo build -p liveboom && node tools/verify-linux-runtime.mjs"
    }
  },
  "nixpkgs": {
    "commit": "8edc0c72e3a38faf5434e40d1f19431125fe4b30"
  }
